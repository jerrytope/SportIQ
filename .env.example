# Copy to .env and fill in. Everything is optional for local development.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Database (default: SQLite file db.sqlite3). Production: PostgreSQL 16.
# DATABASE_URL=postgres://sportiq:sportiq@localhost:5432/sportiq

# Sign users out after this many minutes of inactivity (default 240)
# SESSION_IDLE_MINUTES=240

# Forgot password: false (default) = users contact support and an admin sets a new password in
# /manage/users/; true = users reset their own password by email link (needs working SMTP below)
# PASSWORD_RESET_BY_EMAIL=false

# Email (default prints emails to the console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SportIQ <no-reply@sportiq.edu.ng>

# SMS via Termii (empty = SMS is logged, not sent)
TERMII_API_KEY=
TERMII_SENDER_ID=SportIQ

# Payments via Paystack (empty = built-in test-mode payment page)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Background jobs (empty = tasks run inline in the web process)
# CELERY_BROKER_URL=redis://localhost:6379/0

FFMPEG_BINARY=ffmpeg

# AI study assistant (no key = answers quote approved passages; no AI generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional alternative provider: set AI_PROVIDER=anthropic with ANTHROPIC_API_KEY (+ AI_MODEL)
# AI_PROVIDER=openai

# Live classes (self-host Jitsi for production)
JITSI_DOMAIN=meet.jit.si

# Field encryption for confidential integrity reports. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRITY_ENCRYPTION_KEY=

# Single sign-on (OpenID Connect) for institutional users
OIDC_PROVIDER_NAME=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=

# Phase 4 adapters: enable only where legally authorised and agreements exist
FEDERATION_REGISTRY_URL=
FEDERATION_REGISTRY_TOKEN=
IDENTITY_VERIFICATION_ENABLED=false
IDENTITY_VERIFICATION_PROVIDER=sandbox

# Android Trusted Web Activity wrapper of the PWA (optional)
ANDROID_APP_PACKAGE=
ANDROID_CERT_SHA256=
